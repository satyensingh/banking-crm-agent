# Copy to .env (docker compose reads it automatically). Never commit .env.

# --- LLM provider for the chat agent: anthropic | openai | ollama (free, local) ---
LLM_PROVIDER=openai

# --- Anthropic (when LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- OpenAI (when LLM_PROVIDER=openai; uses the Responses API) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Override for an OpenAI-compatible gateway/proxy
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Ollama (when LLM_PROVIDER=ollama; free, runs locally: `ollama pull qwen3:8b`) ---
OLLAMA_MODEL=qwen3:8b
# From Docker the host's Ollama is host.docker.internal; outside Docker use http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_NUM_CTX=8192
# true = Qwen3 thinks before answering (better tool use, slower)
OLLAMA_REASONING=false

# --- Guardrails (chat UI) ---
# DEV-ONLY DEFAULTS: they work out of the box so you can sign in straight away.
#   Default login:  username  rm   /   password  rm-demo-password
# Replace BOTH before the app is reachable by anyone else (the app logs a warning while they are in use):
#   secret:   chainlit create-secret
#   users:    python -m app.guardrails hash-password   ->  RM_USERS=name=<hash>,name2=<hash>
CHAINLIT_AUTH_SECRET=dev-insecure-change-me-e8iWlFbIat2MHL5bs6tg5IzSS165cNY7YXKpkIWRzafdrhtE
RM_USERS=rm=pbkdf2_sha256:600000:1nWGL69VMPFolnNZ29LfDw:zMaPVEuamTYdKNTGHKvTgIP-Fxd6BeaQnWitSKSeA3M
CHAT_MAX_MESSAGE_CHARS=4000
CHAT_RATE_LIMIT_PER_MIN=10
# Outside Docker; compose writes to the audit_logs volume at /app/logs/audit.jsonl
# AUDIT_LOG_PATH=logs/audit.jsonl

# --- Database ---
POSTGRES_PASSWORD=banking_dev_password
# Used when running the backend outside Docker; compose builds this for containers.
# DATABASE_URL=postgresql://banking_user:banking_dev_password@localhost:5432/banking_crm

# --- MCP server (python -m app.mcp_server) ---
# stdio (default) or http
MCP_TRANSPORT=http
MCP_PORT=8001

# --- Agent (LangGraph) ---
# Where the chat agent's MCP client finds the MCP server (needs MCP_TRANSPORT=http); compose overrides this
# MCP_SERVER_URL=http://127.0.0.1:8001/mcp
