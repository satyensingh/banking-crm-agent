# Copy to .env (docker compose reads it automatically). Never commit .env.

# --- Anthropic (required for /api/chat) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Thinking depth: low | medium | high | xhigh | max
CLAUDE_EFFORT=medium

# --- Database ---
POSTGRES_PASSWORD=banking_dev_password
# Used when running the backend outside Docker; compose builds this for containers.
# DATABASE_URL=postgresql://banking_user:banking_dev_password@localhost:5432/banking_crm

# --- Frontend ---
# false = call the real backend; true = demo fixtures
VITE_DEMO_MODE=false
API_PROXY_TARGET=http://backend:8000
# VITE_API_BASE_URL=

# --- MCP server (python -m app.mcp_server) ---
# stdio (default) or http
MCP_TRANSPORT=http
MCP_PORT=8001
